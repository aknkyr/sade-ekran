<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/ic_menu_today"
        android:theme="@style/Sade"
        android:allowBackup="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity android:name=".GateActivity" android:exported="false" android:excludeFromRecents="true" android:taskAffinity="" />
        <activity android:name=".BlockActivity" android:exported="false" android:excludeFromRecents="true" android:taskAffinity="" />
        <activity android:name=".SettingsActivity" android:exported="false" android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity android:name=".AppPickerActivity" android:exported="false" />

        <service
            android:name=".BlockerService"
            android:exported="false"
            android:label="@string/acc_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>
    </application>
</manifest>
